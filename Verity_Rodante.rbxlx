<Item class="LocalScript" referent="RBX00000000000000000000000000000791">
<Properties>
<string name="Name">ControlRodante</string>
<ProtectedString name="Source"><![CDATA[-- Control de la bola: rodar con WASD / joystick, saltar con espacio / boton de salto.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer

local SPEED = 40       -- studs por segundo
local RESPONSE = 9     -- que tan rapido reacciona al control
local JUMP_SPEED = 52

local controls
task.spawn(function()
	local ok, module = pcall(function()
		return require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule"))
	end)
	if ok and module then
		local ok2, result = pcall(function()
			return module:GetControls()
		end)
		if ok2 then
			controls = result
		end
	end
end)

local function getBall()
	local character = player.Character
	if not character then
		return nil, nil
	end
	local ball = character:FindFirstChild("VerityBall")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if ball and ball:IsA("BasePart") then
		return ball, humanoid
	end
	return nil, humanoid
end

local lastJump = 0
local function tryJump(ball)
	if os.clock() - lastJump < 0.3 then
		return
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { player.Character }
	params.RespectCanCollide = true
	local reach = ball.Size.X / 2 + 0.6
	local hit = workspace:Raycast(ball.Position, Vector3.new(0, -reach, 0), params)
	if hit then
		lastJump = os.clock()
		local v = ball.AssemblyLinearVelocity
		ball.AssemblyLinearVelocity = Vector3.new(v.X, JUMP_SPEED, v.Z)
	end
end

UserInputService.JumpRequest:Connect(function()
	local ball = getBall()
	if ball then
		tryJump(ball)
	end
end)

RunService.RenderStepped:Connect(function(dt)
	local ball, humanoid = getBall()
	if not ball then
		return
	end

	local camera = workspace.CurrentCamera
	if camera and camera.CameraSubject ~= ball then
		camera.CameraSubject = ball
	end

	if humanoid and humanoid.Jump then
		humanoid.Jump = false
		tryJump(ball)
	end

	-- Direccion deseada, relativa a la camara
	local dir = Vector3.zero
	if controls and camera then
		local move = controls:GetMoveVector()
		if move.Magnitude > 0 then
			local cf = camera.CFrame
			local look = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
			if look.Magnitude < 0.05 then
				look = Vector3.new(cf.UpVector.X, 0, cf.UpVector.Z)
			end
			local right = Vector3.new(cf.RightVector.X, 0, cf.RightVector.Z)
			if look.Magnitude > 0.001 and right.Magnitude > 0.001 then
				dir = look.Unit * -move.Z + right.Unit * move.X
			end
		end
	elseif humanoid then
		dir = humanoid.MoveDirection
	end
	if dir.Magnitude > 1 then
		dir = dir.Unit
	end

	local radius = ball.Size.X / 2
	local spin = ball.AssemblyAngularVelocity
	if dir.Magnitude > 0.05 then
		local target = Vector3.new(0, 1, 0):Cross(dir) * (SPEED / radius)
		ball.AssemblyAngularVelocity = spin:Lerp(target, math.clamp(dt * RESPONSE, 0, 1))
	else
		ball.AssemblyAngularVelocity = spin * math.clamp(1 - dt * 1.5, 0, 1)
	end
end)
]]></ProtectedString>
</Properties>
</Item>
</Item>
