<Item class="ServerScriptService" referent="RBX0000000000000000000000000000078D">
<Properties>
<string name="Name">ServerScriptService</string>
</Properties>
<Item class="Script" referent="RBX0000000000000000000000000000078E">
<Properties>
<string name="Name">VerityRodante</string>
<ProtectedString name="Source"><![CDATA[-- Convierte a cada jugador en una mini Verity: una bola amarilla con cara que rueda.
local Players = game:GetService("Players")

local FACE_TEXTURE = "rbxassetid://70414029" -- textura de la cara
local BALL_SIZE = 4
local BALL_COLOR = Color3.fromRGB(255, 205, 30)

local function hidePart(part)
	part.Transparency = 1
	part.CanCollide = false
	part.Massless = true
end

local function buildBall(player, character)
	local humanoid = character:WaitForChild("Humanoid", 10)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if not humanoid or not root then
		return
	end
	if character:FindFirstChild("VerityBall") then
		return
	end

	-- El humanoide no debe pelear contra la fisica de la bola
	humanoid.PlatformStand = true
	humanoid.AutoRotate = false
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff

	-- El cuerpo normal queda invisible y sin colision
	for _, descendant in ipairs(character:GetDescendants()) do
		if descendant:IsA("BasePart") then
			hidePart(descendant)
		end
	end

	local ball = Instance.new("Part")
	ball.Name = "VerityBall"
	ball.Shape = Enum.PartType.Ball
	ball.Size = Vector3.new(BALL_SIZE, BALL_SIZE, BALL_SIZE)
	ball.Color = BALL_COLOR
	ball.Material = Enum.Material.SmoothPlastic
	ball.TopSurface = Enum.SurfaceType.Smooth
	ball.BottomSurface = Enum.SurfaceType.Smooth
	ball.CustomPhysicalProperties = PhysicalProperties.new(0.7, 2, 0.2, 100, 1)
	ball.CFrame = root.CFrame * CFrame.Angles(0, math.pi, 0)

	local face = Instance.new("Decal")
	face.Name = "Cara"
	face.Face = Enum.NormalId.Front
	face.Texture = FACE_TEXTURE
	face.Parent = ball

	local tag = Instance.new("BillboardGui")
	tag.Name = "Nombre"
	tag.Adornee = ball
	tag.Size = UDim2.fromOffset(200, 36)
	tag.StudsOffsetWorldSpace = Vector3.new(0, 3.4, 0)
	tag.MaxDistance = 120
	tag.Parent = ball

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = player.DisplayName
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.4
	label.Font = Enum.Font.GothamBold
	label.TextSize = 18
	label.Parent = tag

	ball.Parent = character

	-- El personaje viaja pegado a la bola
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = ball
	weld.Part1 = root
	weld.Parent = ball

	pcall(function()
		ball:SetNetworkOwner(player)
	end)

	-- Accesorios que carguen despues tambien se ocultan
	character.DescendantAdded:Connect(function(descendant)
		if descendant:IsA("BasePart") and descendant ~= ball and not descendant:IsDescendantOf(ball) then
			hidePart(descendant)
		end
	end)
end

local function onPlayerAdded(player)
	player.CharacterAdded:Connect(function(character)
		buildBall(player, character)
	end)
	if player.Character then
		task.spawn(buildBall, player, player.Character)
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end
]]></ProtectedString>
</Properties>
</Item>
</Item>
