<Item class="Script" referent="RBX8CA7F0F168984674902A5E1D3AF934C6"><Properties><string name="Name">MonsterAI</string>
<bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[-- ===== MONSTRUO + SAFE ZONES (plantilla de juego de terror) =====
-- Todo parte dentro de workspace.SafeZones es una zona segura:
-- el monstruo no puede entrar y no ataca a quien este dentro.
-- Puedes agregar/mover/escalar partes en esa carpeta y funcionan solas.

local Players = game:GetService("Players")
local PathfindingService = game:GetService("PathfindingService")
local PhysicsService = game:GetService("PhysicsService")
local RunService = game:GetService("RunService")

local CONFIG = {
	Speed = 20,            -- velocidad del monstruo
	DetectionRange = 300,  -- distancia maxima a la que detecta jugadores
	AttackDistance = 4.5,  -- distancia para hacer dano
	Damage = 100,          -- dano por golpe (100 = mata)
	AttackCooldown = 1,
	SafeMargin = 1.5,      -- margen extra alrededor de la safe zone
}

local monster = workspace:WaitForChild("Monster")
local hum = monster:WaitForChild("Humanoid")
local root = monster:WaitForChild("HumanoidRootPart")
local safeFolder = workspace:WaitForChild("SafeZones")
local spawnCFrame = root.CFrame

hum.WalkSpeed = CONFIG.Speed

-- Grupos de colision: las safe zones bloquean al monstruo pero no a los jugadores
local function register(name)
	pcall(function() PhysicsService:RegisterCollisionGroup(name) end)
end
register("Monster"); register("SafeZone")
PhysicsService:CollisionGroupSetCollidable("SafeZone", "Default", false)
PhysicsService:CollisionGroupSetCollidable("SafeZone", "SafeZone", false)
PhysicsService:CollisionGroupSetCollidable("SafeZone", "Monster", true)

local function setupMonsterPart(p)
	if p:IsA("BasePart") then p.CollisionGroup = "Monster" end
end
for _, d in ipairs(monster:GetDescendants()) do setupMonsterPart(d) end
monster.DescendantAdded:Connect(setupMonsterPart)

local function setupZone(p)
	if p:IsA("BasePart") then
		p.Anchored = true
		p.CanCollide = true
		p.CollisionGroup = "SafeZone"
	end
end
for _, d in ipairs(safeFolder:GetDescendants()) do setupZone(d) end
safeFolder.DescendantAdded:Connect(setupZone)

local function isSafe(pos)
	for _, z in ipairs(safeFolder:GetDescendants()) do
		if z:IsA("BasePart") then
			local rel = z.CFrame:PointToObjectSpace(pos)
			local h = z.Size / 2
			local m = CONFIG.SafeMargin
			if math.abs(rel.X) <= h.X + m and math.abs(rel.Y) <= h.Y + m and math.abs(rel.Z) <= h.Z + m then
				return true
			end
		end
	end
	return false
end

local function getTarget()
	local best, bestDist, bestHum
	for _, plr in ipairs(Players:GetPlayers()) do
		local char = plr.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local h = char and char:FindFirstChildOfClass("Humanoid")
		if hrp and h and h.Health > 0 and not isSafe(hrp.Position) then
			local d = (hrp.Position - root.Position).Magnitude
			if d <= CONFIG.DetectionRange and (not bestDist or d < bestDist) then
				best, bestDist, bestHum = hrp, d, h
			end
		end
	end
	return best, bestDist, bestHum
end

-- Animacion simple de caminar (piernas y brazos)
local torso = monster:WaitForChild("Torso")
local joints = {}
for _, n in ipairs({"Right Hip", "Left Hip", "Right Shoulder", "Left Shoulder"}) do
	local m = torso:WaitForChild(n)
	joints[n] = {motor = m, base = m.C0}
end
local t, amp = 0, 0
RunService.Heartbeat:Connect(function(dt)
	local moving = hum.MoveDirection.Magnitude > 0.1
	amp += ((moving and 1 or 0) - amp) * math.min(1, dt * 10)
	t += dt * CONFIG.Speed * 0.5
	local a = math.sin(t) * 0.9 * amp
	joints["Right Hip"].motor.C0 = joints["Right Hip"].base * CFrame.Angles(0, 0, a)
	joints["Left Hip"].motor.C0 = joints["Left Hip"].base * CFrame.Angles(0, 0, a)
	joints["Right Shoulder"].motor.C0 = joints["Right Shoulder"].base * CFrame.Angles(0, 0, -a)
	joints["Left Shoulder"].motor.C0 = joints["Left Shoulder"].base * CFrame.Angles(0, 0, -a)
end)

pcall(function() root:SetNetworkOwner(nil) end)

local lastAttack = 0
while true do
	if root.Position.Y < -50 then
		monster:PivotTo(spawnCFrame)
	end

	local target, dist, targetHum = getTarget()
	if target then
		if dist <= CONFIG.AttackDistance and os.clock() - lastAttack >= CONFIG.AttackCooldown then
			lastAttack = os.clock()
			targetHum:TakeDamage(CONFIG.Damage)
		end

		local path = PathfindingService:CreatePath({
			AgentRadius = 2, AgentHeight = 5, AgentCanJump = true,
		})
		local ok = pcall(function() path:ComputeAsync(root.Position, target.Position) end)
		if ok and path.Status == Enum.PathStatus.Success then
			local wps = path:GetWaypoints()
			local wp = wps[2] or wps[1]
			if wp then
				if wp.Action == Enum.PathWaypointAction.Jump then hum.Jump = true end
				hum:MoveTo(wp.Position)
			end
		else
			hum:MoveTo(target.Position)
		end
	else
		hum:MoveTo(root.Position) -- sin objetivos: se queda quieto
	end
	task.wait(0.15)
end
]]></ProtectedString></Properties></Item></Item></roblox>