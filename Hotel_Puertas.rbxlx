	<Item class="StarterPlayer" referent="RBX5">
		<Properties>
			<string name="Name">StarterPlayer</string>
		</Properties>
		<Item class="StarterPlayerScripts" referent="RBX6">
		<Properties>
			<string name="Name">StarterPlayerScripts</string>
		</Properties>
		<Item class="LocalScript" referent="RBX7">
			<Properties>
				<string name="Name">AvisosHotel</string>
				<bool name="Disabled">false</bool>
				<ProtectedString name="Source"><![CDATA[-- Avisos en pantalla y cartel de habitacion (LocalScript)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local notify = ReplicatedStorage:WaitForChild("Notify")

local gui = Instance.new("ScreenGui")
gui.Name = "AvisosHotel"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local function makeLabel(pos, size, textSize, font)
	local l = Instance.new("TextLabel")
	l.AnchorPoint = Vector2.new(0.5, 0.5)
	l.Position = pos
	l.Size = size
	l.BackgroundTransparency = 1
	l.TextColor3 = Color3.fromRGB(240, 220, 170)
	l.Font = font
	l.TextSize = textSize
	l.TextWrapped = true
	l.TextTransparency = 1
	l.TextStrokeTransparency = 1
	l.Parent = gui
	return l
end

local function makeShower(label, seconds)
	local token = 0
	return function(text)
		token = token + 1
		local mine = token
		label.Text = text
		label.TextTransparency = 0
		label.TextStrokeTransparency = 0.5
		task.delay(seconds, function()
			if token == mine then
				TweenService:Create(label, TweenInfo.new(0.8), {
					TextTransparency = 1,
					TextStrokeTransparency = 1,
				}):Play()
			end
		end)
	end
end

local msgLabel = makeLabel(UDim2.fromScale(0.5, 0.74), UDim2.fromOffset(560, 70), 22, Enum.Font.GothamMedium)
local roomLabel = makeLabel(UDim2.fromScale(0.5, 0.14), UDim2.fromOffset(500, 60), 40, Enum.Font.Garamond)

local showMsg = makeShower(msgLabel, 4)
local showRoom = makeShower(roomLabel, 2.2)

notify.OnClientEvent:Connect(showMsg)

player:GetAttributeChangedSignal("Room"):Connect(function()
	local n = player:GetAttribute("Room")
	if n and n > 0 then
		showRoom("HABITACION " .. string.format("%03d", n))
	end
end)

task.delay(2, function()
	showMsg("Abre las puertas con E. Pulsa 1 para sacar la linterna.")
end)
]]></ProtectedString>
			</Properties>
		</Item>
	</Item>
	</Item>
</roblox>
